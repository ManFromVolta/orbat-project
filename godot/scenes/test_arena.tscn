[sub_resource type="Shader" id="Shader_4brrt"]
code = "shader_type spatial;
varying vec3 wp;
void vertex() { wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
	vec2 c = floor(wp.xz);
	float k = mod(c.x + c.y, 2.0);
	ALBEDO = mix(vec3(0.27, 0.29, 0.26), vec3(0.36, 0.38, 0.34), k);
	ROUGHNESS = 1.0;
}
"

